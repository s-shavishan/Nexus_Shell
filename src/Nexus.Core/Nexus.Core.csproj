<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>3.2.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon>../Nexus.Shell/Assets/Nexus.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Nexus.Runtime/Nexus.Runtime.csproj" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../Nexus.Shell/Services/AudioController.cs" Link="Settings/AudioController.cs" />
    <Compile Include="../Nexus.Shell/Services/BrightnessController.cs" Link="Settings/BrightnessController.cs" />
    <Compile Include="../Nexus.Shell/Services/BrightnessScale.cs" Link="Settings/BrightnessScale.cs" />
  </ItemGroup>
</Project>
