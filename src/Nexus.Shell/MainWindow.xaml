<Window x:Class="Nexus.Shell.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="using:Nexus.Shell.UI" Title="NEXUS — Aura">
 <Grid x:Name="DesktopRoot" RequestedTheme="Dark" Loaded="Desktop_Loaded" SizeChanged="Desktop_SizeChanged">
  <Grid.Resources>
   <ui:AppAccentConverter x:Key="AppAccent"/>
   <DataTemplate x:Key="AppTile">
    <StackPanel Width="114" Spacing="9" Padding="6,10" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Name}">
     <Border Width="56" Height="56" CornerRadius="18" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1" Background="{Binding Category, Converter={StaticResource AppAccent}}" HorizontalAlignment="Center">
      <FontIcon Glyph="{Binding Glyph}" FontSize="25" Foreground="{ThemeResource NexusText}" FontFamily="Segoe MDL2 Assets"/>
     </Border>
     <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{ThemeResource NexusText}" TextTrimming="CharacterEllipsis" TextAlignment="Center" ToolTipService.ToolTip="{Binding Name}"/>
    </StackPanel>
   </DataTemplate>
   <ItemsPanelTemplate x:Key="AppItemsPanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="122" ItemHeight="118"/></ItemsPanelTemplate>
   <Style x:Key="AppContainer" TargetType="GridViewItem">
    <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="CornerRadius" Value="14"/>
   </Style>
   <DataTemplate x:Key="WindowTile">
    <Border Padding="17" CornerRadius="18" Background="{ThemeResource NexusCard}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1" AutomationProperties.Name="{Binding Title}">
     <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="11" Background="{ThemeResource NexusSidebar}"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource NexusAccent}"/></Border><TextBlock Grid.Column="1" Text="{Binding ProcessName}" VerticalAlignment="Center" Foreground="{ThemeResource NexusMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/></Grid>
      <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="16" Foreground="{ThemeResource NexusText}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title}"/>
      <TextBlock Grid.Row="2" Text="Return to this window ↗" FontSize="10" Foreground="{ThemeResource NexusAccent}"/>
     </Grid>
    </Border>
   </DataTemplate>
   <ItemsPanelTemplate x:Key="WindowItemsPanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="254" ItemHeight="186"/></ItemsPanelTemplate>
  </Grid.Resources>
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#131529" Offset="0"/><GradientStop Color="#1D2940" Offset="0.52"/><GradientStop Color="#0D222B" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="104"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- Static vector wallpaper: no texture allocation or animation loop. -->
  <Viewbox x:Name="WallpaperAccents" Grid.RowSpan="5" Stretch="UniformToFill" IsHitTestVisible="False" Opacity="0.85">
   <Canvas Width="1600" Height="1000">
    <Path Data="M 430,-160 C 1240,-170 1320,640 1870,310 L 1870,1110 C 970,1200 1360,240 430,-160 Z"><Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5360A2" Offset="0"/><GradientStop Color="#253C67" Offset="0.5"/><GradientStop Color="#183D43" Offset="1"/></LinearGradientBrush></Path.Fill></Path>
    <Path Data="M 640,-120 C 1400,120 1050,750 1750,620" StrokeThickness="1.5" Stroke="#60978ED1"/>
    <Path Data="M 840,-160 C 1530,120 1100,990 1720,780 L 1740,1190 C 840,1060 1340,360 840,-160 Z"><Path.Fill><LinearGradientBrush><GradientStop Color="#7270AF" Offset="0"/><GradientStop Color="#29365B" Offset="0.55"/><GradientStop Color="#387373" Offset="1"/></LinearGradientBrush></Path.Fill></Path>
    <Path Data="M -190,780 C 510,430 400,1190 1200,1110" Stroke="#205DDDCE" StrokeThickness="160"/>
   </Canvas>
  </Viewbox>
  <Border x:Name="MenuBar" Margin="24,16,24,8" CornerRadius="20" Background="{ThemeResource NexusShell}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1">
   <Grid Margin="16,0" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"><Border Background="{ThemeResource NexusAccent}" CornerRadius="10" Width="30" Height="30"><TextBlock Text="N" Foreground="{ThemeResource NexusAccentText}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="BrandingText" Text="NEXUS" CharacterSpacing="90" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource NexusText}" VerticalAlignment="Center"/><Button x:Name="CompactNavigation" Visibility="Collapsed" Style="{StaticResource IconButton}" AutomationProperties.Name="Navigate Nexus"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE700;" FontSize="16"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Desktop" Tag="Home" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Workspaces" Tag="Workspaces" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Explore" Tag="Explore" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Study" Tag="Study" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Apps" Tag="Apps" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Entertainment" Tag="Gaming" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Window overview" Tag="Running apps" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Activity" Tag="Activity" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Personalize" Tag="Personalize" Click="NavigateMenu_Click"/></MenuFlyout></Button.Flyout></Button></StackPanel>
    <StackPanel x:Name="MenuLinks" Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
     <Button x:Name="TopNavHome" Content="Desktop" Tag="Home" Click="Navigate_Click" Style="{StaticResource QuietButton}"/>
     <Button x:Name="TopNavProfiles" Content="Workspaces" Tag="Workspaces" Click="Navigate_Click" Style="{StaticResource QuietButton}"/>
     <Button x:Name="TopNavExplore" Content="Explore" Tag="Explore" Click="Navigate_Click" Style="{StaticResource QuietButton}"/>
     <Button x:Name="TopNavStudy" Content="Study" Tag="Study" Click="Navigate_Click" Style="{StaticResource QuietButton}"/>
     <Button x:Name="TopNavApps" Content="Apps" Tag="Apps" Click="Navigate_Click" Style="{StaticResource QuietButton}"/>
     <Button Content="More" Style="{StaticResource QuietButton}"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Entertainment" Tag="Gaming" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Window overview" Tag="Running apps" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Activity" Tag="Activity" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Personalize" Tag="Personalize" Click="NavigateMenu_Click"/></MenuFlyout></Button.Flyout></Button>
    </StackPanel>
    <Border Grid.Column="2" Background="Transparent" PointerPressed="DragArea_PointerPressed" ToolTipService.ToolTip="Drag to move Nexus"/>
    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
     <TextBlock x:Name="MenuClock" FontSize="12" Foreground="{ThemeResource NexusText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <Button x:Name="FullScreenButton" Click="FullScreen_Click" Style="{StaticResource IconButton}" AutomationProperties.Name="Toggle full screen" ToolTipService.ToolTip="Full screen · F11"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE740;" FontSize="16"/></Button>
     <Button x:Name="ControlsButton" Style="{StaticResource IconButton}" AutomationProperties.Name="Control center" ToolTipService.ToolTip="Control center">
      <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="16"/>
      <Button.Flyout>
       <Flyout x:Name="ControlsFlyout" Placement="BottomEdgeAlignedRight" Opening="Controls_Opening" Opened="Controls_Opened" Closed="Controls_Closed">
        <Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter"><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="26"/><Setter Property="MaxWidth" Value="420"/></Style></Flyout.FlyoutPresenterStyle>
        <Border x:Name="ControlPanel" Width="400" Background="{ThemeResource NexusShell}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1" CornerRadius="26" Padding="24">
         <Grid RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Control center" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource NexusText}" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Content="Close" Click="CloseControls_Click" Style="{StaticResource QuietButton}"/></Grid>
          <ScrollViewer x:Name="ControlScroller" Grid.Row="1" MaxHeight="580" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
           <StackPanel Spacing="17">
            <TextBlock Text="YOUR WINDOWS, WITHIN REACH" Foreground="{ThemeResource NexusMuted}" FontSize="10" CharacterSpacing="120"/>
            <Grid ColumnSpacing="10" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <Button Grid.Row="0" Grid.Column="0" Tag="ms-settings:sound" Click="SystemSettings_Click" Style="{StaticResource AuraSurfaceButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Spacing="9"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="20" Foreground="{ThemeResource NexusSecondary}" HorizontalAlignment="Left"/><TextBlock Text="Sound" FontSize="13"/><TextBlock Text="Windows settings ↗" FontSize="10" Foreground="{ThemeResource NexusMuted}"/></StackPanel></Button>
             <Button Grid.Row="0" Grid.Column="1" Tag="ms-settings:network-status" Click="SystemSettings_Click" Style="{StaticResource AuraSurfaceButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Spacing="9"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE701;" FontSize="20" Foreground="{ThemeResource NexusSecondary}" HorizontalAlignment="Left"/><TextBlock Text="Network" FontSize="13"/><TextBlock Text="Windows settings ↗" FontSize="10" Foreground="{ThemeResource NexusMuted}"/></StackPanel></Button>
             <Button Grid.Row="1" Grid.Column="0" Tag="ms-settings:bluetooth" Click="SystemSettings_Click" Style="{StaticResource AuraSurfaceButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Spacing="9"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE702;" FontSize="20" Foreground="{ThemeResource NexusSecondary}" HorizontalAlignment="Left"/><TextBlock Text="Bluetooth" FontSize="13"/><TextBlock Text="Windows settings ↗" FontSize="10" Foreground="{ThemeResource NexusMuted}"/></StackPanel></Button>
             <Button Grid.Row="1" Grid.Column="1" Tag="ms-settings:display" Click="SystemSettings_Click" Style="{StaticResource AuraSurfaceButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Spacing="9"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" FontSize="20" Foreground="{ThemeResource NexusSecondary}" HorizontalAlignment="Left"/><TextBlock Text="Display" FontSize="13"/><TextBlock Text="Windows settings ↗" FontSize="10" Foreground="{ThemeResource NexusMuted}"/></StackPanel></Button>
            </Grid>
            <ComboBox x:Name="WallpaperBox" Header="Desktop mood" SelectionChanged="Wallpaper_SelectionChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="Pearl · iris and charcoal"/><ComboBoxItem Content="Lagoon · deep teal"/><ComboBoxItem Content="Graphite · cool blue"/></ComboBox>
            <Button Content="Personalize desktop…" Click="Personalize_Click" Style="{StaticResource AuraSurfaceButton}" HorizontalAlignment="Stretch"/>
            <TextBox x:Name="DisplayNameBox" Header="Your name" MaxLength="40"/>
            <Button Content="Save name" Click="SaveName_Click" HorizontalAlignment="Left" Style="{StaticResource AuraSurfaceButton}"/>
            <ToggleSwitch x:Name="GlassSwitch" Header="Native glass" Toggled="Glass_Toggled" OffContent="Pearl surfaces" OnContent="Windows acrylic"/>
            <TextBlock x:Name="GlassStatus" Foreground="{ThemeResource NexusMuted}" FontSize="12" TextWrapping="Wrap"/>
            <ToggleSwitch x:Name="EffectsSwitch" Header="Reduced effects" Toggled="Effects_Toggled" OffContent="Nexus signature" OnContent="Simpler surfaces and no custom motion"/>
            <TextBlock Text="Short interaction animations follow Windows animation settings. Reduced effects keeps every feature available." Foreground="{ThemeResource NexusMuted}" FontSize="12" TextWrapping="Wrap"/>
            <ToggleSwitch x:Name="DesktopLayoutSwitch" Header="Desktop layout" Toggled="DesktopLayout_Toggled" OffContent="Workspace panel" OnContent="Open desktop canvas"/>
            <ToggleSwitch x:Name="GlobalShortcutSwitch" Header="Summon Nexus from other apps" Toggled="GlobalShortcut_Toggled" OffContent="Off" OnContent="Ctrl+Alt+Space"/>
            <TextBlock x:Name="DesktopShortcutStatus" Foreground="{ThemeResource NexusMuted}" FontSize="12" TextWrapping="Wrap"/>
            <ToggleSwitch x:Name="ResidentSwitch" Header="Keep Nexus available" Toggled="Resident_Toggled" OffContent="Closing exits Nexus" OnContent="Closing hides to notification area"/>
            <TextBlock Text="While hidden, your focus timer continues and enabled usage tracking stays active. Use the Nexus notification-area icon to reopen or exit." Foreground="{ThemeResource NexusMuted}" FontSize="12" TextWrapping="Wrap"/>
            <ToggleSwitch x:Name="ResumeWorkspaceSwitch" Header="Remember last workspace" Toggled="ResumeWorkspace_Toggled" OffContent="Start on Home" OnContent="Return to the last page"/>
            <ToggleSwitch x:Name="FocusSwitch" Header="Focus view" Toggled="Focus_Toggled" OffContent="Show desktop widgets" OnContent="Give your workspace more room"/>
            <ToggleSwitch x:Name="TrackingSwitch" Header="App usage tracking" Toggled="Tracking_Toggled" OffContent="Off" OnContent="On"/>
            <TextBlock Text="Approximate foreground time while Nexus is open. Idle time is excluded. Stored only on this PC." Foreground="{ThemeResource NexusMuted}" FontSize="12" TextWrapping="Wrap"/>
            <ToggleSwitch x:Name="StartupSwitch" Header="Start after Windows sign-in" Toggled="Startup_Toggled" OffContent="Off" OnContent="On"/>
            <TextBlock x:Name="StartupRepairHint" Text="Sign-in startup points to a different Nexus folder." Visibility="Collapsed" Foreground="{ThemeResource NexusMuted}" FontSize="12" TextWrapping="Wrap"/>
            <Button x:Name="StartupRepairButton" Content="Use this version at sign-in" Click="StartupRepair_Click" Visibility="Collapsed" HorizontalAlignment="Stretch" Style="{StaticResource AuraSurfaceButton}"/>
            <Button Content="Open Nexus data folder" Click="DataFolder_Click" HorizontalAlignment="Stretch" Style="{StaticResource AuraSurfaceButton}"/>
            <Button Content="Exit Nexus" Click="Exit_Click" HorizontalAlignment="Stretch" Style="{StaticResource AuraSurfaceButton}"/>
           </StackPanel>
          </ScrollViewer>
         </Grid>
        </Border>
       </Flyout>
      </Button.Flyout>
     </Button>
     <Button Click="HideNexus_Click" Style="{StaticResource IconButton}" AutomationProperties.Name="Hide Nexus" ToolTipService.ToolTip="Hide Nexus · return with Ctrl+Alt+Space"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8BB;" FontSize="16"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="32,0" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
    <Button x:Name="BackButton" Click="Back_Click" Style="{StaticResource IconButton}" Width="30" IsEnabled="False" AutomationProperties.Name="Go back" ToolTipService.ToolTip="Go back · Alt+Left"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72B;" FontSize="14"/></Button>
    <Button x:Name="ForwardButton" Click="Forward_Click" Style="{StaticResource IconButton}" Width="30" IsEnabled="False" AutomationProperties.Name="Go forward" ToolTipService.ToolTip="Go forward · Alt+Right"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72A;" FontSize="14"/></Button>
   </StackPanel>
   <TextBlock Grid.Column="1" x:Name="ActiveProfileText" Text="NEXUS DESKTOP  /  PERSONAL" Foreground="{ThemeResource NexusMuted}" FontSize="10" CharacterSpacing="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   <Button Grid.Column="2" Click="SearchApps_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Search your orbit" ToolTipService.ToolTip="Search your orbit · Ctrl+K"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="14"/><TextBlock x:Name="SearchLabel" Text="Search your orbit" FontSize="12"/><TextBlock x:Name="SearchShortcut" Text="Ctrl K" Foreground="{ThemeResource NexusMuted}" FontSize="11"/></StackPanel></Button>
  </Grid>
  <Grid Grid.Row="2" Margin="32,0" ColumnSpacing="28" x:Name="Workspace"><Grid.ColumnDefinitions><ColumnDefinition x:Name="DesktopColumn" Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="DesktopWidgets" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12" Padding="0,28,4,0">
    <Border x:Name="AuraFocusPill" Padding="14,8" CornerRadius="14" Background="{ThemeResource NexusSelection}" HorizontalAlignment="Left"><TextBlock x:Name="FocusBadge" Text="Your orbit" FontSize="11" Foreground="{ThemeResource NexusAccent}"/></Border>
    <TextBlock x:Name="AuraPaletteLabel" Foreground="{ThemeResource NexusMuted}" FontSize="9" CharacterSpacing="100" TextWrapping="Wrap"/>
    <TextBlock x:Name="DateText" Foreground="{ThemeResource NexusMuted}" FontSize="14"/>
    <TextBlock x:Name="ClockText" FontSize="78" FontWeight="Light" Foreground="{ThemeResource NexusText}" Margin="-4,-12,0,0"/>
    <TextBlock x:Name="ClockPeriod" Foreground="{ThemeResource NexusMuted}" FontSize="14" Margin="0,-8,0,0" Visibility="Collapsed"/>
    <TextBlock x:Name="GreetingText" Foreground="{ThemeResource NexusText}" FontSize="16" TextWrapping="Wrap" Margin="0,4,0,20"/>
    <Border x:Name="SpaceCard" Padding="19" CornerRadius="20" Background="{ThemeResource NexusCard}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1"><StackPanel Spacing="10"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D4;" FontSize="22" Foreground="{ThemeResource NexusAccent}" HorizontalAlignment="Left"/><TextBlock x:Name="SpaceName" FontSize="18" Foreground="{ThemeResource NexusText}" TextWrapping="Wrap"/><TextBlock Text="A little space for your next big idea." FontSize="13" Foreground="{ThemeResource NexusMuted}" TextWrapping="Wrap"/></StackPanel></Border>
    <Button Content="Open my files" Tag="files" Click="QuickLaunch_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
    <Button Content="Windows settings" Tag="settings" Click="QuickLaunch_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Column="1" x:Name="HomeBorder" MaxWidth="1300" CornerRadius="26" Background="{ThemeResource NexusPanel}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1" HorizontalAlignment="Stretch">
    <Grid><Grid.RowDefinitions><RowDefinition x:Name="ChromeRow" Height="50"/><RowDefinition Height="*"/><RowDefinition x:Name="FooterRow" Height="34"/></Grid.RowDefinitions>
     <Border x:Name="WindowChrome" Background="{ThemeResource NexusSidebar}" CornerRadius="26,26,0,0" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="0,0,0,1">
      <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
        <Button Width="26" Height="30" Padding="0" Click="HideHome_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Hide workspace" ToolTipService.ToolTip="Hide workspace"><Ellipse Width="11" Height="11" Fill="#FF7F88"/></Button>
        <Button Width="26" Height="30" Padding="0" Click="Minimize_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Minimize Nexus" ToolTipService.ToolTip="Minimize Nexus"><Ellipse Width="11" Height="11" Fill="#F1CE80"/></Button>
        <Button Width="26" Height="30" Padding="0" Click="ExpandHome_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Expand workspace" ToolTipService.ToolTip="Expand workspace"><Ellipse Width="11" Height="11" Fill="#87DCC2"/></Button>
       </StackPanel>
       <TextBlock x:Name="PageTitle" Text="Nexus Home" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource NexusMuted}" TextTrimming="CharacterEllipsis"/>
       <Button Grid.Column="2" Style="{StaticResource IconButton}" AutomationProperties.Name="Workspace navigation" ToolTipService.ToolTip="Workspace navigation"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE700;" FontSize="16"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Home" Tag="Home" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Explore" Tag="Explore" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Study" Tag="Study" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Apps" Tag="Apps" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Games" Tag="Gaming" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Activity" Tag="Activity" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Personalize" Tag="Personalize" Click="NavigateMenu_Click"/><MenuFlyoutItem Text="Window overview" Tag="Running apps" Click="NavigateMenu_Click"/></MenuFlyout></Button.Flyout></Button>
      </Grid>
     </Border>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="Sidebar" Background="{ThemeResource NexusSidebar}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="0,0,1,0">
       <Grid Margin="14,22,14,16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="5"><TextBlock Text="WORKSPACE" FontSize="10" CharacterSpacing="120" Margin="12,0,0,13" Foreground="{ThemeResource NexusMuted}"/>
         <Button x:Name="NavProfiles" Tag="Workspaces" Click="Navigate_Click" Style="{StaticResource SidebarButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8F1;" FontSize="17"/><TextBlock Text="Workspaces" FontSize="13"/></StackPanel></Button>
         <Button x:Name="NavHome" Tag="Home" Click="Navigate_Click" Style="{StaticResource SidebarButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE80F;" FontSize="17"/><TextBlock Text="Home" FontSize="13"/></StackPanel></Button>
         <Button x:Name="NavExplore" Tag="Explore" Click="Navigate_Click" Style="{StaticResource SidebarButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE774;" FontSize="17"/><TextBlock Text="Explore" FontSize="13"/></StackPanel></Button>
         <Button x:Name="NavStudy" Tag="Study" Click="Navigate_Click" Style="{StaticResource SidebarButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE916;" FontSize="17"/><TextBlock Text="Study" FontSize="13"/></StackPanel></Button>
         <Button x:Name="NavApps" Tag="Apps" Click="Navigate_Click" Style="{StaticResource SidebarButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71D;" FontSize="17"/><TextBlock Text="Apps" FontSize="13"/></StackPanel></Button>
         <Button x:Name="NavGames" Tag="Gaming" Click="Navigate_Click" Style="{StaticResource SidebarButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7FC;" FontSize="17"/><TextBlock Text="Games" FontSize="13"/></StackPanel></Button>
         <Button x:Name="NavActivity" Tag="Activity" Click="Navigate_Click" Style="{StaticResource SidebarButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE9D9;" FontSize="17"/><TextBlock Text="Activity" FontSize="13"/></StackPanel></Button>
         <TextBlock Text="YOUR SESSION" FontSize="10" CharacterSpacing="120" Margin="12,24,0,10" Foreground="{ThemeResource NexusMuted}"/>
         <Button x:Name="NavRunning" Tag="Running apps" Click="Navigate_Click" Style="{StaticResource SidebarButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" FontSize="17"/><TextBlock Text="Window overview" FontSize="12"/></StackPanel></Button>
         <Button x:Name="NavPersonalize" Tag="Personalize" Click="Navigate_Click" Style="{StaticResource SidebarButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE790;" FontSize="17"/><TextBlock Text="Personalize" FontSize="13"/></StackPanel></Button>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="0,1,0,0" Padding="9,16,0,0"><StackPanel Spacing="5"><TextBlock x:Name="SidebarName" FontSize="13" Foreground="{ThemeResource NexusText}" TextTrimming="CharacterEllipsis"/><TextBlock Text="Personal workspace" FontSize="11" Foreground="{ThemeResource NexusMuted}"/></StackPanel></Border>
       </Grid>
      </Border>
      <Grid x:Name="PageHost" Grid.Column="1" SizeChanged="PageHost_SizeChanged">
       <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Padding="16,12,16,24">
         <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="HomeGreeting" FontSize="15" Foreground="{ThemeResource NexusMuted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          <Button Grid.Column="1" Content="Workspaces" Tag="Workspaces" Click="Navigate_Click" Style="{StaticResource QuietButton}"/>
         </Grid>
         <Grid x:Name="ProfileStrip" ColumnSpacing="10" RowSpacing="10"/>
         <Border x:Name="HeroCard" CornerRadius="26" Padding="30" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#DD4B426A" Offset="0"/><GradientStop Color="#DB2B3854" Offset="0.65"/><GradientStop Color="#DC28474C" Offset="1"/></LinearGradientBrush></Border.Background>
          <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="YOUR PERSONAL DESKTOP" FontSize="10" CharacterSpacing="150" Foreground="{ThemeResource NexusAccent}"/>
            <TextBlock x:Name="HeroTitle" Text="Your day, your space." FontSize="36" FontWeight="SemiBold" Foreground="{ThemeResource NexusText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="HeroDescription" FontSize="14" Foreground="{ThemeResource NexusMuted}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ProfileSummary" FontSize="12" Foreground="{ThemeResource NexusMuted}"/>
            <StackPanel x:Name="ProfileHeroActions" Orientation="Horizontal" Spacing="8">
             <Button x:Name="ProfileOpenButton" Content="Open Personal" Click="ProfileOpen_Click" Style="{StaticResource AuraPrimaryButton}"/>
             <Button x:Name="ProfileDestinationButton" Content="Your apps" Click="ProfileDestination_Click" Style="{StaticResource QuietButton}"/>
             <Button Content="Configure" Click="ProfileEdit_Click" Style="{StaticResource QuietButton}"/>
            </StackPanel>
           </StackPanel>
           <Viewbox x:Name="HomeHeroArt" Grid.Column="1" Width="135" Height="148" IsHitTestVisible="False"><Grid Width="160" Height="170"><Ellipse Width="118" Height="118" Fill="{ThemeResource NexusIcon}" Stroke="{ThemeResource NexusSecondary}" StrokeThickness="1"/><Ellipse Width="156" Height="57" Stroke="{ThemeResource NexusAccent}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-32"/></Ellipse.RenderTransform></Ellipse><Ellipse Width="147" Height="46" Stroke="{ThemeResource NexusSecondary}" StrokeThickness="1" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="34"/></Ellipse.RenderTransform></Ellipse><TextBlock Text="N" FontSize="68" FontWeight="Light" Foreground="{ThemeResource NexusText}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="9" Height="9" Fill="{ThemeResource NexusAccent}" Margin="120,13,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/></Grid></Viewbox>
          </Grid>
         </Border>
         <Grid x:Name="HomeCards" ColumnSpacing="16" RowSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="HomePrimaryColumn" Width="*"/><ColumnDefinition x:Name="HomeSecondaryColumn" Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="HomeTaskCard" Padding="20" CornerRadius="20" Background="{ThemeResource NexusCard}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1"><StackPanel Spacing="12"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="In focus" Foreground="{ThemeResource NexusText}" FontSize="19" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Study" Tag="Study" Click="Navigate_Click" Style="{StaticResource QuietButton}" FontSize="12"/></Grid><TextBlock x:Name="HomeTaskSummary" Foreground="{ThemeResource NexusMuted}" FontSize="13" TextWrapping="Wrap"/><StackPanel x:Name="HomeTaskList" Spacing="8"/><TextBlock x:Name="HomeFocusCount" Foreground="{ThemeResource NexusMuted}" FontSize="12"/></StackPanel></Border>
          <Border x:Name="HomeFavoritesCard" Grid.Column="1" Padding="20" CornerRadius="20" Background="{ThemeResource NexusCard}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1"><StackPanel Spacing="12"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Within reach" Foreground="{ThemeResource NexusText}" FontSize="19" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Explore" Tag="Explore" Click="Navigate_Click" Style="{StaticResource QuietButton}" FontSize="12"/></Grid><StackPanel x:Name="HomeFavorites" Spacing="7"/><TextBlock x:Name="HomeSavedCount" Foreground="{ThemeResource NexusMuted}" FontSize="12"/></StackPanel></Border>
          <Border x:Name="HomeEssentialsCard" Grid.Row="1" Padding="20" CornerRadius="20" Background="{ThemeResource NexusCard}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1"><StackPanel Spacing="12">
           <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Your essentials" FontSize="19" FontWeight="SemiBold" Foreground="{ThemeResource NexusText}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="App Library" Tag="Apps" Click="Navigate_Click" Style="{StaticResource QuietButton}" FontSize="12"/></Grid>
           <TextBlock x:Name="HomePinsEmpty" Text="Pin an app in App Library to keep it here." Foreground="{ThemeResource NexusMuted}" Visibility="Collapsed" TextWrapping="Wrap"/>
           <GridView x:Name="HomePins" MaxHeight="252" Margin="-6,-8,-6,0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick" ContainerContentChanging="AppContainer_ContentChanging" ItemTemplate="{StaticResource AppTile}" ItemsPanel="{StaticResource AppItemsPanel}" ItemContainerStyle="{StaticResource AppContainer}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
          </StackPanel></Border>
          <Border x:Name="HomeNotesCard" Grid.Row="1" Grid.Column="1" Padding="20" CornerRadius="20" Background="{ThemeResource NexusCard}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1"><StackPanel Spacing="12"><TextBlock Text="A thought to keep" FontSize="19" FontWeight="SemiBold" Foreground="{ThemeResource NexusText}"/><TextBox x:Name="QuickNotesBox" PlaceholderText="A thought, a plan, a reminder…" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="10000" MaxHeight="170" MinHeight="140" TextChanged="QuickNotes_TextChanged" AutomationProperties.Name="Local quick notes"/><TextBlock Text="Shared with your Study notes · saved on this PC" Foreground="{ThemeResource NexusMuted}" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
         </Grid>
         <Grid x:Name="ShortcutRow" ColumnSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button x:Name="FilesCard" Tag="Explore" Click="Navigate_Click" Style="{StaticResource ShortcutCard}"><StackPanel Spacing="10"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource NexusAccent}" HorizontalAlignment="Left"/><TextBlock Text="My world" FontSize="14"/></StackPanel></Button>
          <Button x:Name="GamesCard" Grid.Column="1" Tag="Gaming" Click="Navigate_Click" Style="{StaticResource ShortcutCard}"><StackPanel Spacing="10"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7FC;" FontSize="20" Foreground="{ThemeResource NexusAccent}" HorizontalAlignment="Left"/><TextBlock Text="Entertainment" FontSize="14"/></StackPanel></Button>
          <Button x:Name="FocusCard" Grid.Column="2" Click="FocusCard_Click" Style="{StaticResource ShortcutCard}"><StackPanel Spacing="10"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE708;" FontSize="20" Foreground="{ThemeResource NexusAccent}" HorizontalAlignment="Left"/><TextBlock x:Name="FocusCardLabel" Text="Study time" FontSize="14" TextWrapping="Wrap"/></StackPanel></Button>
         </Grid>
         <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HomeWindowsSummary" Text="Return to your open apps through window overview" FontSize="12" Foreground="{ThemeResource NexusMuted}" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Overview" Click="Running_Click" Style="{StaticResource QuietButton}"/></Grid>
         <TextBlock x:Name="HomeRecentText" Text="Ready for your next idea." Foreground="{ThemeResource NexusMuted}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
       </ScrollViewer>
       <!-- Finite viewport outside the page ScrollViewer keeps the app library virtualized. -->
       <Grid x:Name="AppLibraryView" Visibility="Collapsed" Padding="24" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="6"><TextBlock x:Name="LibraryHeading" Text="App Library" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource NexusText}"/><TextBlock x:Name="LibraryDescription" FontSize="12" Foreground="{ThemeResource NexusMuted}" TextWrapping="Wrap"/></StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AppsSearchBox" PlaceholderText="Find an app" TextChanged="AppsSearch_TextChanged" AutomationProperties.Name="Find an app"/><Button Grid.Column="1" x:Name="AddAppButton" Content="Add…" Click="AddApp_Click" Style="{StaticResource AuraSurfaceButton}"/><Button Grid.Column="2" x:Name="RefreshAppsButton" Click="RefreshApps_Click" Style="{StaticResource IconButton}" AutomationProperties.Name="Refresh app discovery" ToolTipService.ToolTip="Refresh Start menu apps"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="17"/></Button></Grid>
        <Grid Grid.Row="2"><TextBlock x:Name="LibraryCountText" FontSize="11" Foreground="{ThemeResource NexusMuted}"/><ProgressRing x:Name="DiscoveryProgress" Width="15" Height="15" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Right"/></Grid>
        <Grid Grid.Row="3"><GridView x:Name="AppsGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick" ContainerContentChanging="AppContainer_ContentChanging" ItemTemplate="{StaticResource AppTile}" ItemsPanel="{StaticResource AppItemsPanel}" ItemContainerStyle="{StaticResource AppContainer}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"/><TextBlock x:Name="LibraryEmpty" Text="No matching apps." Foreground="{ThemeResource NexusMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16" Visibility="Collapsed"/></Grid>
       </Grid>
       <!-- Window cards have their own finite viewport and virtualizing panel. -->
       <Grid x:Name="WindowOverviewView" Visibility="Collapsed" Padding="24" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="6"><TextBlock Text="Everything in your orbit." FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource NexusText}" TextWrapping="Wrap"/><TextBlock Text="Find an open window and return to it. Ctrl+4 opens this view." FontSize="12" Foreground="{ThemeResource NexusMuted}" TextWrapping="Wrap"/></StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WindowsSearchBox" PlaceholderText="Find a window or app" MaxLength="100" TextChanged="WindowsSearch_TextChanged" AutomationProperties.Name="Find an open window"/><Button Grid.Column="1" x:Name="RefreshWindowsButton" Click="RefreshWindows_Click" Style="{StaticResource IconButton}" ToolTipService.ToolTip="Refresh open windows" AutomationProperties.Name="Refresh open windows"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="17"/></Button></Grid>
        <TextBlock Grid.Row="2" x:Name="WindowCountText" Text="Finding open windows…" FontSize="11" Foreground="{ThemeResource NexusMuted}"/>
        <Grid Grid.Row="3"><GridView x:Name="WindowsGrid" SizeChanged="WindowsGrid_SizeChanged" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Window_ItemClick" ItemTemplate="{StaticResource WindowTile}" ItemsPanel="{StaticResource WindowItemsPanel}" ItemContainerStyle="{StaticResource AppContainer}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"/><TextBlock x:Name="WindowsEmpty" Text="No other visible windows yet." Visibility="Collapsed" Foreground="{ThemeResource NexusMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16"/></Grid>
       </Grid>
       <ScrollViewer x:Name="PageScroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PageContent" Spacing="16" Padding="24"/></ScrollViewer>
      </Grid>
     </Grid>
     <Border x:Name="WindowFooter" Grid.Row="2" Background="{ThemeResource NexusSidebar}" CornerRadius="0,0,26,26" Padding="18,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PageStatus" Text="Your personal workspace" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NexusMuted}"/><TextBlock Grid.Column="1" Text="NEXUS  0.7.0" VerticalAlignment="Center" Foreground="{ThemeResource NexusMuted}" FontSize="9" CharacterSpacing="90" Margin="12,0,0,0"/></Grid></Border>
    </Grid>
   </Border>
   <Button Grid.Column="1" x:Name="ReopenHomeButton" Content="Open Nexus Home" Click="Reopen_Click" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,14" CornerRadius="14"/>
  </Grid>
  <Grid Grid.Row="3" Margin="32,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="ResourceText" Text="Nexus · native desktop" FontSize="11" Foreground="{ThemeResource NexusMuted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,18,0"/>
   <Border x:Name="DockBorder" Grid.Column="1" VerticalAlignment="Center" CornerRadius="26" Background="{ThemeResource NexusShell}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1" Padding="12,10"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="DockHomeButton" Click="Reopen_Click" Style="{StaticResource DockButton}" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Nexus Home" AutomationProperties.Name="Nexus Home"><Border Width="48" Height="48" CornerRadius="16" Background="{ThemeResource NexusAccent}"><TextBlock Text="N" FontSize="27" Foreground="{ThemeResource NexusAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Button><Border Width="1" Background="{ThemeResource NexusBorder}" Margin="4,8"/><StackPanel Orientation="Horizontal" Spacing="9" x:Name="DockApps"/><StackPanel Orientation="Horizontal" Spacing="4" x:Name="DockRunningApps" Visibility="Collapsed"/><Button x:Name="DockSearchButton" Click="SearchApps_Click" Style="{StaticResource DockButton}" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Search your orbit · Ctrl+K" AutomationProperties.Name="Search your orbit"><Border Width="48" Height="48" CornerRadius="16" Background="{ThemeResource NexusCard}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="22"/></Border></Button><Button x:Name="DockRunningButton" Click="Running_Click" Background="Transparent" BorderBrush="Transparent" Style="{StaticResource DockButton}" ToolTipService.ToolTip="Window overview · Ctrl+4" AutomationProperties.Name="Window overview"><Border Width="48" Height="48" Background="{ThemeResource NexusCard}" CornerRadius="16" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" FontSize="22"/></Border></Button></StackPanel></Border>
   <Button Grid.Column="2" x:Name="FooterSettingsButton" Content="Control center" Click="Controls_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="12"/>
  </Grid>
  <InfoBar Grid.Row="4" x:Name="StatusBar" IsOpen="False" IsClosable="True" Severity="Informational" Margin="20,0,20,12"/>
  <!-- Bounded command palette; the desktop shortcut uses RegisterHotKey, not a keyboard hook. -->
  <Grid x:Name="CommandOverlay" Grid.RowSpan="5" Canvas.ZIndex="50" Visibility="Collapsed">
   <Button Click="CloseCommand_Click" IsTabStop="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{ThemeResource NexusOverlay}" BorderThickness="0" AutomationProperties.Name="Close search"/>
   <Border x:Name="CommandPanel" TabFocusNavigation="Cycle" MaxWidth="680" Margin="22,96,22,22" HorizontalAlignment="Stretch" VerticalAlignment="Top" Padding="24" CornerRadius="26" Background="{ThemeResource NexusPanel}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1">
    <Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox FontSize="18" Padding="16,14" x:Name="CommandSearchBox" PlaceholderText="Search your orbit…" MaxLength="100" TextChanged="CommandSearch_TextChanged" PreviewKeyDown="CommandSearch_KeyDown" AutomationProperties.Name="Search your orbit"/><Button Grid.Column="1" Content="Esc" Click="CloseCommand_Click" Style="{StaticResource QuietButton}"/></Grid>
     <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="CommandCategories" Orientation="Horizontal" Spacing="4">
      <Button Content="All" Tag="All" Click="CommandCategory_Click" Style="{StaticResource QuietButton}" FontSize="12" Padding="10,8" AutomationProperties.Name="Search all"/>
      <Button Content="Apps" Tag="Apps" Click="CommandCategory_Click" Style="{StaticResource QuietButton}" FontSize="12" Padding="10,8" AutomationProperties.Name="Search apps"/>
      <Button Content="Saved" Tag="Saved" Click="CommandCategory_Click" Style="{StaticResource QuietButton}" FontSize="12" Padding="10,8" AutomationProperties.Name="Search saved"/>
      <Button Content="Workspaces" Tag="Workspaces" Click="CommandCategory_Click" Style="{StaticResource QuietButton}" FontSize="12" Padding="10,8" AutomationProperties.Name="Search workspaces"/>
      <Button Content="Actions" Tag="Actions" Click="CommandCategory_Click" Style="{StaticResource QuietButton}" FontSize="12" Padding="10,8" AutomationProperties.Name="Search actions"/>
      <Button Content="Tasks" Tag="Tasks" Click="CommandCategory_Click" Style="{StaticResource QuietButton}" FontSize="12" Padding="10,8" AutomationProperties.Name="Search tasks"/>
      <Button Content="Windows" Tag="Windows" Click="CommandCategory_Click" Style="{StaticResource QuietButton}" FontSize="12" Padding="10,8" AutomationProperties.Name="Search windows"/>
     </StackPanel></ScrollViewer>
     <Grid Grid.Row="2" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CommandSectionTitle" Text="SUGGESTED" FontSize="10" CharacterSpacing="100" Foreground="{ThemeResource NexusMuted}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CommandResultCount" Grid.Column="1" FontSize="11" Foreground="{ThemeResource NexusMuted}"/></Grid>
     <Grid Grid.Row="3"><ListView x:Name="CommandList" MaxHeight="360" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Command_ItemClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListView.ItemTemplate><DataTemplate><Grid Padding="10,10" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="10" Background="{ThemeResource NexusCard}"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{Binding Glyph}" FontSize="17" Foreground="{ThemeResource NexusAccent}"/></Border><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Title}" Foreground="{ThemeResource NexusText}" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource NexusMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
     </ListView><TextBlock x:Name="CommandEmpty" Text="No matching items in this category." Foreground="{ThemeResource NexusMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" TextWrapping="Wrap"/></Grid>
     <TextBlock x:Name="CommandHint" Grid.Row="4" Text="↑ ↓ choose     Enter open     Esc close" Foreground="{ThemeResource NexusMuted}" FontSize="11" TextWrapping="Wrap"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
