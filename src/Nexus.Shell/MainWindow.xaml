  <Grid x:Name="CommandOverlay" Grid.RowSpan="2" Canvas.ZIndex="50" Visibility="Collapsed">
   <Button Click="CloseCommand_Click" IsTabStop="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{ThemeResource NexusOverlay}" BorderThickness="0" AutomationProperties.Name="Close search" />
   <Border x:Name="CommandPanel" TabFocusNavigation="Cycle" MaxWidth="720" Margin="22,104,22,22" HorizontalAlignment="Stretch" VerticalAlignment="Top" Padding="24" CornerRadius="26" Background="{ThemeResource NexusPanel}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1">
    <Grid RowSpacing="14">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
     </Grid.RowDefinitions>
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox FontSize="19" Padding="14,12" x:Name="CommandSearchBox" PlaceholderText="Search your orbit…" MaxLength="100" TextChanged="CommandSearch_TextChanged" PreviewKeyDown="CommandSearch_KeyDown" AutomationProperties.Name="Search your orbit" />
      <Button Grid.Column="1" Content="Esc" Click="CloseCommand_Click" Style="{StaticResource QuietButton}" />
     </Grid>
     <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel x:Name="CommandCategories" Orientation="Horizontal" Spacing="3">
       <Button Content="All" Tag="All" Click="CommandCategory_Click" Style="{StaticResource SegmentButton}" FontSize="12" Padding="10,6" AutomationProperties.Name="Search all" />
       <Button Content="Apps" Tag="Apps" Click="CommandCategory_Click" Style="{StaticResource SegmentButton}" FontSize="12" Padding="10,6" AutomationProperties.Name="Search apps" />
       <Button Content="Saved" Tag="Saved" Click="CommandCategory_Click" Style="{StaticResource SegmentButton}" FontSize="12" Padding="10,6" AutomationProperties.Name="Search saved" />
       <Button Content="Workspaces" Tag="Workspaces" Click="CommandCategory_Click" Style="{StaticResource SegmentButton}" FontSize="12" Padding="10,6" AutomationProperties.Name="Search workspaces" />
       <Button Content="Actions" Tag="Actions" Click="CommandCategory_Click" Style="{StaticResource SegmentButton}" FontSize="12" Padding="10,6" AutomationProperties.Name="Search actions" />
       <Button Content="Tasks" Tag="Tasks" Click="CommandCategory_Click" Style="{StaticResource SegmentButton}" FontSize="12" Padding="10,6" AutomationProperties.Name="Search tasks" />
       <Button Content="Windows" Tag="Windows" Click="CommandCategory_Click" Style="{StaticResource SegmentButton}" FontSize="12" Padding="10,6" AutomationProperties.Name="Search windows" />
      </StackPanel>
     </ScrollViewer>
     <Grid Grid.Row="2" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="CommandSectionTitle" Text="SUGGESTED" FontSize="10" CharacterSpacing="100" Foreground="{ThemeResource NexusMuted}" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="CommandResultCount" Grid.Column="1" FontSize="11" Foreground="{ThemeResource NexusMuted}" />
     </Grid>
     <Grid Grid.Row="3">
      <ListView x:Name="CommandList" MaxHeight="360" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Command_ItemClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListView.ItemTemplate>
        <DataTemplate>
         <Grid Padding="10,10" ColumnSpacing="14">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="Auto" />
           <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="10" Background="{ThemeResource NexusCard}">
           <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{Binding Glyph}" FontSize="17" Foreground="{ThemeResource NexusAccent}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3">
           <TextBlock Text="{Binding Title}" Foreground="{ThemeResource NexusText}" FontSize="14" TextTrimming="CharacterEllipsis" />
           <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource NexusMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
         </Grid>
        </DataTemplate>
       </ListView.ItemTemplate>
      </ListView>
      <TextBlock x:Name="CommandEmpty" Text="No matching items in this category." Foreground="{ThemeResource NexusMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" TextWrapping="Wrap" />
     </Grid>
     <TextBlock x:Name="CommandHint" Grid.Row="4" Text="↑ ↓ choose     Enter open     Esc close" Foreground="{ThemeResource NexusMuted}" FontSize="11" TextWrapping="Wrap" />
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
