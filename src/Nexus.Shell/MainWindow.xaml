<!-- නමෝ බුද්ධාය 🤍 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Nexus.Shell.MainWindow" Title="Nexus Controls">
 <Border x:Name="DesktopRoot" CornerRadius="14" BorderThickness="1" BorderBrush="{ThemeResource NexusBorder}" Background="{ThemeResource NexusPanel}" RequestedTheme="Dark" SizeChanged="Root_SizeChanged">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Padding="12,0,16,0" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button Width="26" Height="32" Padding="0" Style="{StaticResource QuietButton}" Click="Close_Click" AutomationProperties.Name="Close Nexus Controls" ToolTipService.ToolTip="Close Nexus Controls"><Ellipse Width="12" Height="12" Fill="#FFFF6058"/></Button>
     <Button Width="26" Height="32" Padding="0" Style="{StaticResource QuietButton}" Click="Minimize_Click" AutomationProperties.Name="Minimize Nexus Controls" ToolTipService.ToolTip="Minimize"><Ellipse Width="12" Height="12" Fill="#FFFFBD2D"/></Button>
     <Button Width="26" Height="32" Padding="0" Style="{StaticResource QuietButton}" Click="Maximize_Click" AutomationProperties.Name="Maximize or restore Nexus Controls" ToolTipService.ToolTip="Maximize or restore"><Ellipse Width="12" Height="12" Fill="#FF28C840"/></Button>
    </StackPanel>
    <Border x:Name="ControlsDragArea" Grid.Column="1" Background="Transparent"><TextBlock Text="Nexus Controls" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource NexusText}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Border>
   </Grid>
   <Grid Grid.Row="1" x:Name="ControlsBody">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Padding="14,22,14,16" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource NexusBorder}">
     <Grid RowSpacing="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Spacing="7" Margin="10,0,0,0"><TextBlock Text="NEXUS" FontSize="12" CharacterSpacing="200" Foreground="{ThemeResource NexusMuted}"/><TextBlock Text="Your controls." FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource NexusText}"/></StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Navigation" Spacing="5"/></ScrollViewer>
      <StackPanel Grid.Row="2" Spacing="8"><Button Content="Windows tools ↗" Click="WindowsTools_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch"/><TextBlock Text="Built around your desktop" FontSize="11" Foreground="{ThemeResource NexusMuted}" HorizontalAlignment="Center"/></StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Column="1" Padding="24,16,24,20" RowSpacing="16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <ComboBox x:Name="CompactNavigation" Visibility="Collapsed" HorizontalAlignment="Stretch" DisplayMemberPath="Title" SelectionChanged="CompactNavigation_Changed" AutomationProperties.Name="Controls page"/>
     <TextBox x:Name="SettingsSearch" Grid.Row="1" PlaceholderText="Find a setting…" MaxLength="160" TextChanged="SettingsSearch_Changed" AutomationProperties.Name="Search Nexus settings"/>
     <StackPanel Grid.Row="2" Spacing="5"><TextBlock x:Name="PageTitle" FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource NexusText}" TextWrapping="Wrap"/><TextBlock x:Name="PageSubtitle" FontSize="13" Foreground="{ThemeResource NexusMuted}" TextWrapping="Wrap"/></StackPanel>
     <ScrollViewer x:Name="PageScroll" Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PageContent" Spacing="14" Padding="0,0,6,12"/></ScrollViewer>
    </Grid>
   </Grid>
   <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource NexusBorder}" Padding="18,10,18,10"><TextBlock x:Name="StatusText" Text="Changes apply across your desktop and save automatically." FontSize="12" Foreground="{ThemeResource NexusMuted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border>
  </Grid>
 </Border>
</Window>
