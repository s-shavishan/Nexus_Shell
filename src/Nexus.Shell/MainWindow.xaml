<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="using:Nexus.Shell.UI" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Nexus.Shell.MainWindow" Title="NEXUS — Midnight Glass">
 <Grid x:Name="DesktopRoot" RequestedTheme="Dark" KeyboardAcceleratorPlacementMode="Hidden" Background="{ThemeResource NexusPanel}" Loaded="Desktop_Loaded" SizeChanged="Desktop_SizeChanged">
  <Grid.Resources>
   <ui:AppAccentConverter x:Key="AppAccent" />
   <ui:SavedKindConverter x:Key="SavedKind" />
   <ui:SavedIconConverter x:Key="SavedIcon" />
   <ui:SavedSubtitleConverter x:Key="SavedSubtitle" />
   <ui:AppIconConverter x:Key="AppIcon" />
   <DataTemplate x:Key="ExploreListTile">
    <Border Padding="10,8" CornerRadius="8" Background="{ThemeResource NexusCard}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1" AutomationProperties.Name="{Binding Title}">
     <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto" />
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Width="32" Height="32" Source="{Binding Kind, Converter={StaticResource SavedIcon}}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
       <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource NexusText}" TextTrimming="CharacterEllipsis" />
       <TextBlock Text="{Binding Converter={StaticResource SavedSubtitle}}" FontSize="11" Foreground="{ThemeResource NexusMuted}" TextTrimming="CharacterEllipsis" MaxLines="1" />
      </StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="10" Foreground="{ThemeResource NexusMuted}" VerticalAlignment="Center" />
     </Grid>
    </Border>
   </DataTemplate>
   <DataTemplate x:Key="ExploreTile">
    <Border Padding="16" CornerRadius="16" Background="{ThemeResource NexusCard}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
     <Grid RowSpacing="9">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto" />
       <RowDefinition Height="Auto" />
       <RowDefinition Height="*" />
       <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>
       <Image Width="42" Height="42" Source="{Binding Kind, Converter={StaticResource SavedIcon}}" HorizontalAlignment="Left" />
       <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{Binding Favorite, Converter={StaticResource SavedKind}}" Foreground="{ThemeResource NexusAccent}" FontSize="13" />
        <TextBlock Text="{Binding Kind}" Foreground="{ThemeResource NexusMuted}" FontSize="10" />
       </StackPanel>
      </Grid>
      <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource NexusText}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
      <StackPanel Grid.Row="2" Spacing="4">
       <TextBlock Text="{Binding Note}" Foreground="{ThemeResource NexusMuted}" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
       <TextBlock Text="{Binding Target}" Foreground="{ThemeResource NexusMuted}" FontSize="10" TextTrimming="CharacterEllipsis" MaxLines="1" />
      </StackPanel>
      <TextBlock Grid.Row="3" Text="{Binding Collection}" Foreground="{ThemeResource NexusAccent}" FontSize="10" TextTrimming="CharacterEllipsis" />
     </Grid>
    </Border>
   </DataTemplate>
   <ItemsPanelTemplate x:Key="ExploreItemsPanel">
    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="230" ItemHeight="212" />
   </ItemsPanelTemplate>
   <Style x:Key="ExploreContainer" TargetType="GridViewItem">
    <Setter Property="Margin" Value="0,0,10,10" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="16" />
   </Style>
   <DataTemplate x:Key="AppTile">
    <StackPanel Width="114" Spacing="9" Padding="6,10" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Name}">
     <Image Width="60" Height="60" Source="{Binding Converter={StaticResource AppIcon}}" HorizontalAlignment="Center" />
     <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{ThemeResource NexusText}" TextTrimming="CharacterEllipsis" TextAlignment="Center" ToolTipService.ToolTip="{Binding Name}" />
    </StackPanel>
   </DataTemplate>
   <ItemsPanelTemplate x:Key="AppItemsPanel">
    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="122" ItemHeight="118" />
   </ItemsPanelTemplate>
   <Style x:Key="AppContainer" TargetType="GridViewItem">
    <Setter Property="Margin" Value="3" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="14" />
   </Style>
   <DataTemplate x:Key="WindowTile">
    <Border Padding="17" CornerRadius="18" Background="{ThemeResource NexusCard}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1" AutomationProperties.Name="{Binding Title}">
     <Grid RowSpacing="12">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto" />
       <RowDefinition Height="*" />
       <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid ColumnSpacing="10">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
       </Grid.ColumnDefinitions>
       <Border Width="36" Height="36" CornerRadius="11" Background="{ThemeResource NexusSidebar}">
        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18" Foreground="{ThemeResource NexusAccent}" />
       </Border>
       <TextBlock Grid.Column="1" Text="{Binding ProcessName}" VerticalAlignment="Center" Foreground="{ThemeResource NexusMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
      </Grid>
      <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="16" Foreground="{ThemeResource NexusText}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title}" />
      <TextBlock Grid.Row="2" Text="Return to this window ↗" FontSize="10" Foreground="{ThemeResource NexusAccent}" />
     </Grid>
    </Border>
   </DataTemplate>
   <ItemsPanelTemplate x:Key="WindowItemsPanel">
    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="254" ItemHeight="186" />
   </ItemsPanelTemplate>
  </Grid.Resources>
  <Grid.RowDefinitions>
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <Border x:Name="HomeBorder" CornerRadius="0" Background="{ThemeResource NexusPanel}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="0" HorizontalAlignment="Stretch">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition x:Name="ChromeRow" Height="68" />
     <RowDefinition Height="*" />
     <RowDefinition x:Name="FooterRow" Height="34" />
    </Grid.RowDefinitions>
    <Border x:Name="WindowChrome" Background="{ThemeResource NexusPanel}" CornerRadius="0" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="0">
     <Grid Margin="12,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto" />
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
       <Button Width="24" Height="28" Padding="0" Click="CloseSections_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Close Sections" ToolTipService.ToolTip="Close Sections">
        <Ellipse Width="11" Height="11" Fill="#FF5F57" />
       </Button>
       <Button Width="24" Height="28" Padding="0" Click="Minimize_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Minimize Sections" ToolTipService.ToolTip="Minimize Sections">
        <Ellipse Width="11" Height="11" Fill="#FEBC2E" />
       </Button>
       <Button Width="24" Height="28" Padding="0" Click="ExpandHome_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Expand workspace" ToolTipService.ToolTip="Expand workspace">
        <Ellipse Width="11" Height="11" Fill="#28C840" />
       </Button>
       <Border Width="1" Height="18" Background="{ThemeResource NexusBorder}" Margin="10,0,7,0" />
       <Button x:Name="BackButton" IsEnabled="False" Click="Back_Click" Style="{StaticResource IconButton}" Width="32" AutomationProperties.Name="Previous page" ToolTipService.ToolTip="Previous page · Alt+Left">
        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="14" />
       </Button>
       <Button x:Name="ForwardButton" IsEnabled="False" Click="Forward_Click" Style="{StaticResource IconButton}" Width="32" AutomationProperties.Name="Next page" ToolTipService.ToolTip="Next page · Alt+Right">
        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="14" />
       </Button>
      </StackPanel>
      <Border Grid.Column="1" Background="Transparent" PointerPressed="DragArea_PointerPressed" />
      <TextBlock Visibility="Collapsed" IsHitTestVisible="False" x:Name="PageTitle" Text="Sections" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource NexusText}" TextTrimming="CharacterEllipsis" />
      <Button x:Name="ChromeSearchButton" Grid.Column="1" Click="SearchApps_Click" Style="{StaticResource QuietButton}" MaxWidth="520" HorizontalAlignment="Stretch" Margin="24,0" Padding="14,8" CornerRadius="22" Background="{ThemeResource NexusInput}" AutomationProperties.Name="Search Nexus; Control K">
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="16" Foreground="{ThemeResource NexusMuted}"/>
        <TextBlock Grid.Column="1" Text="Search apps, files and workspaces…" Foreground="{ThemeResource NexusMuted}" FontSize="13" VerticalAlignment="Center"/>
        <Border Grid.Column="2" CornerRadius="7" Padding="7,2" Background="{ThemeResource NexusSelection}"><TextBlock Text="Ctrl K" Foreground="{ThemeResource NexusMuted}" FontSize="10"/></Border>
       </Grid>
      </Button>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
       <Button Click="SearchApps_Click" Style="{StaticResource IconButton}" AutomationProperties.Name="Search Nexus" ToolTipService.ToolTip="Search · Ctrl+K">
        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="16" />
       </Button>
       <Button Click="NewExploreNote_Click" Style="{StaticResource IconButton}" AutomationProperties.Name="Capture a note" ToolTipService.ToolTip="Capture a note · Ctrl+N">
        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="16" />
       </Button>
       <Button Style="{StaticResource IconButton}" AutomationProperties.Name="Workspace navigation" ToolTipService.ToolTip="Workspace navigation">
        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="16" />
        <Button.Flyout>
         <MenuFlyout>
          <MenuFlyoutItem Text="Overview" Tag="Home" Click="NavigateMenu_Click" />
          <MenuFlyoutItem Text="Explore" Tag="Explore" Click="NavigateMenu_Click" />
          <MenuFlyoutItem Text="Study" Tag="Study" Click="NavigateMenu_Click" />
          <MenuFlyoutItem Text="Apps" Tag="Apps" Click="NavigateMenu_Click" />
          <MenuFlyoutItem Text="Games" Tag="Gaming" Click="NavigateMenu_Click" />
          <MenuFlyoutItem Text="Activity" Tag="Activity" Click="NavigateMenu_Click" />
          <MenuFlyoutItem Text="PC controls" Tag="PC controls" Click="NavigateMenu_Click" />
          <MenuFlyoutItem Text="Personalize" Tag="Personalize" Click="NavigateMenu_Click" />
          <MenuFlyoutItem Text="Window overview" Tag="Running apps" Click="NavigateMenu_Click" />
         </MenuFlyout>
        </Button.Flyout>
       </Button>
       <Button x:Name="ControlsButton" Style="{StaticResource IconButton}" AutomationProperties.Name="Control center" ToolTipService.ToolTip="Control center">
        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="16" />
        <Button.Flyout>
         <Flyout x:Name="ControlsFlyout" Placement="BottomEdgeAlignedRight" Opening="Controls_Opening" Opened="Controls_Opened" Closed="Controls_Closed">
          <Flyout.FlyoutPresenterStyle>
           <Style TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="MaxWidth" Value="420" />
           </Style>
          </Flyout.FlyoutPresenterStyle>
          <Border x:Name="ControlPanel" Width="400" Background="{ThemeResource NexusShell}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1" CornerRadius="26" Padding="24">
           <Grid RowSpacing="16">
            <Grid.RowDefinitions>
             <RowDefinition Height="Auto" />
             <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
             </Grid.ColumnDefinitions>
             <TextBlock Text="Control center" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource NexusText}" TextTrimming="CharacterEllipsis" />
             <Button Grid.Column="1" Content="Close" Click="CloseControls_Click" Style="{StaticResource QuietButton}" />
            </Grid>
            <ScrollViewer x:Name="ControlScroller" Grid.Row="1" MaxHeight="580" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
             <StackPanel Spacing="17">
              <Border Padding="14" CornerRadius="14" Background="{ThemeResource NexusCard}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1">
               <StackPanel Spacing="8">
                <Grid>
                 <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                 </Grid.ColumnDefinitions>
                 <TextBlock Text="Sound" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource NexusText}" VerticalAlignment="Center" />
                 <Button Grid.Column="1" Content="Refresh" Click="PcRefresh_Click" Style="{StaticResource QuietButton}" />
                </Grid>
                <TextBlock x:Name="QuickAudioDevice" Text="Open this panel to read your audio output" FontSize="12" Foreground="{ThemeResource NexusMuted}" TextWrapping="Wrap" />
                <TextBlock x:Name="QuickVolumeText" Text="Output volume" FontSize="12" Foreground="{ThemeResource NexusText}" />
                <Grid ColumnSpacing="12">
                 <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                 </Grid.ColumnDefinitions>
                 <Slider x:Name="QuickMasterSlider" Minimum="0" Maximum="100" StepFrequency="1" IsEnabled="False" ValueChanged="QuickVolume_Changed" AutomationProperties.Name="Master output volume" />
                 <Button x:Name="QuickMuteButton" Grid.Column="1" Content="Mute" IsEnabled="False" Click="QuickMute_Click" Style="{StaticResource AuraSurfaceButton}" AutomationProperties.Name="Mute master output" />
                </Grid>
               </StackPanel>
              </Border>
              <Button Content="Open PC controls" Click="PcControls_Click" Style="{StaticResource AuraPrimaryButton}" HorizontalAlignment="Stretch" />
              <TextBlock Text="MORE CONTROLS" Foreground="{ThemeResource NexusMuted}" FontSize="10" CharacterSpacing="120" />
              <Grid ColumnSpacing="10" RowSpacing="10">
               <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
               </Grid.RowDefinitions>
               <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
               </Grid.ColumnDefinitions>
               <Button Grid.Row="0" Grid.Column="0" Click="PcControls_Click" Style="{StaticResource AuraSurfaceButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Spacing="9">
                 <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="20" Foreground="{ThemeResource NexusSecondary}" HorizontalAlignment="Left" />
                 <TextBlock Text="App mixer" FontSize="13" />
                 <TextBlock Text="App volumes" FontSize="10" Foreground="{ThemeResource NexusMuted}" />
                </StackPanel>
               </Button>
               <Button Grid.Row="0" Grid.Column="1" Tag="ms-settings:network-status" Click="SystemSettings_Click" Style="{StaticResource AuraSurfaceButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Spacing="9">
                 <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="20" Foreground="{ThemeResource NexusSecondary}" HorizontalAlignment="Left" />
                 <TextBlock Text="Network" FontSize="13" />
                 <TextBlock Text="Windows settings ↗" FontSize="10" Foreground="{ThemeResource NexusMuted}" />
                </StackPanel>
               </Button>
               <Button Grid.Row="1" Grid.Column="0" Tag="ms-settings:bluetooth" Click="SystemSettings_Click" Style="{StaticResource AuraSurfaceButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Spacing="9">
                 <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="20" Foreground="{ThemeResource NexusSecondary}" HorizontalAlignment="Left" />
                 <TextBlock Text="Bluetooth" FontSize="13" />
                 <TextBlock Text="Windows settings ↗" FontSize="10" Foreground="{ThemeResource NexusMuted}" />
                </StackPanel>
               </Button>
               <Button Grid.Row="1" Grid.Column="1" Tag="ms-settings:display" Click="SystemSettings_Click" Style="{StaticResource AuraSurfaceButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Spacing="9">
                 <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="20" Foreground="{ThemeResource NexusSecondary}" HorizontalAlignment="Left" />
                 <TextBlock Text="Display" FontSize="13" />
                 <TextBlock Text="Windows settings ↗" FontSize="10" Foreground="{ThemeResource NexusMuted}" />
                </StackPanel>
               </Button>
              </Grid>
              <ComboBox x:Name="WallpaperBox" Header="Desktop mood" SelectionChanged="Wallpaper_SelectionChanged" HorizontalAlignment="Stretch">
               <ComboBoxItem Content="Midnight Glass · sapphire &amp; frost" />
               <ComboBoxItem Content="Solstice · warm pearl" />
               <ComboBoxItem Content="Ember · sunset &amp; rose" />
               <ComboBoxItem Content="Opal · luminous glass" />
               <ComboBoxItem Content="Pearl · iris and charcoal" />
               <ComboBoxItem Content="Lagoon · deep teal" />
               <ComboBoxItem Content="Graphite · cool blue" />
              </ComboBox>
              <Button Content="Personalize desktop…" Click="Personalize_Click" Style="{StaticResource AuraSurfaceButton}" HorizontalAlignment="Stretch" />
              <Expander Header="Session preferences" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Foreground="{ThemeResource NexusText}">
               <StackPanel Spacing="16">
                <TextBox x:Name="DisplayNameBox" Header="Your name" MaxLength="40" />
                <Button Content="Save name" Click="SaveName_Click" HorizontalAlignment="Left" Style="{StaticResource AuraSurfaceButton}" />
                <ToggleSwitch x:Name="GlassSwitch" Header="Frosted surfaces" Toggled="Glass_Toggled" OffContent="Layered surfaces" OnContent="Soft background blur" />
                <TextBlock x:Name="GlassStatus" Foreground="{ThemeResource NexusMuted}" FontSize="12" TextWrapping="Wrap" />
                <ToggleSwitch x:Name="EffectsSwitch" Header="Reduced effects" Toggled="Effects_Toggled" OffContent="Nexus signature" OnContent="Simpler surfaces and no custom motion" />
                <TextBlock Text="Motion follows your Windows animation preference. Reduced effects uses simpler surfaces." Foreground="{ThemeResource NexusMuted}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock x:Name="DesktopShortcutStatus" Foreground="{ThemeResource NexusMuted}" FontSize="12" TextWrapping="Wrap" />
                <ToggleSwitch x:Name="ResidentSwitch" Header="Windows notification icon" Toggled="Resident_Toggled" OffContent="Taskbar remains available" OnContent="Notification icon enabled" />
                <TextBlock Text="Focus continues while Sections is minimized; closing Sections pauses it. Your desktop and enabled usage tracking stay available." Foreground="{ThemeResource NexusMuted}" FontSize="12" TextWrapping="Wrap" />
                <ToggleSwitch x:Name="ResumeWorkspaceSwitch" Header="Remember last workspace" Toggled="ResumeWorkspace_Toggled" OffContent="Open on Explore" OnContent="Return to the last page" />
                <ToggleSwitch x:Name="TrackingSwitch" Header="App usage tracking" Toggled="Tracking_Toggled" OffContent="Off" OnContent="On" />
                <TextBlock Text="Approximate foreground time while Nexus is open. Idle time is excluded. Stored only on this PC." Foreground="{ThemeResource NexusMuted}" FontSize="12" TextWrapping="Wrap" />
                <ToggleSwitch x:Name="StartupSwitch" Header="Start after Windows sign-in" Toggled="Startup_Toggled" OffContent="Off" OnContent="On" />
                <TextBlock x:Name="StartupRepairHint" Text="Sign-in startup points to a different Nexus folder." Visibility="Collapsed" Foreground="{ThemeResource NexusMuted}" FontSize="12" TextWrapping="Wrap" />
                <Button x:Name="StartupRepairButton" Content="Use this version at sign-in" Click="StartupRepair_Click" Visibility="Collapsed" HorizontalAlignment="Stretch" Style="{StaticResource AuraSurfaceButton}" />
                <Button Content="Open Nexus data folder" Click="DataFolder_Click" HorizontalAlignment="Stretch" Style="{StaticResource AuraSurfaceButton}" />
                <Button Content="Exit Nexus" Click="Exit_Click" HorizontalAlignment="Stretch" Style="{StaticResource AuraSurfaceButton}" />
               </StackPanel>
              </Expander>
             </StackPanel>
            </ScrollViewer>
           </Grid>
          </Border>
         </Flyout>
        </Button.Flyout>
       </Button>
      </StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="244" />
      <ColumnDefinition Width="*" />
     </Grid.ColumnDefinitions>
     <Border x:Name="Sidebar" Margin="13,14,0,14" CornerRadius="24" Background="{ThemeResource NexusSidebar}" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="1">
      <Grid Margin="10,18,10,16">
       <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
       </Grid.RowDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="6">
         <TextBlock Text="NEXUS" FontSize="10" CharacterSpacing="120" Margin="12,0,0,13" Foreground="{ThemeResource NexusMuted}" />
         <Button x:Name="NavHome" Tag="Home" Click="Navigate_Click" Style="{StaticResource SidebarButton}" AutomationProperties.Name="Overview">
          <StackPanel Orientation="Horizontal" Spacing="12">
           <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE80F;" FontSize="19"/>
           <TextBlock Text="Overview" FontSize="13" />
          </StackPanel>
         </Button>
         <Button x:Name="NavProfiles" Tag="Workspaces" Click="Navigate_Click" Style="{StaticResource SidebarButton}">
          <StackPanel Orientation="Horizontal" Spacing="12">
           <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" FontSize="19"/>
           <TextBlock Text="Workspaces" FontSize="13" />
          </StackPanel>
         </Button>
         <Button x:Name="NavExplore" Tag="Explore" Click="Navigate_Click" Style="{StaticResource SidebarButton}">
          <StackPanel Orientation="Horizontal" Spacing="12">
           <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE774;" FontSize="19"/>
           <TextBlock Text="Explore" FontSize="13" />
          </StackPanel>
         </Button>
         <Button x:Name="NavStudy" Tag="Study" Click="Navigate_Click" Style="{StaticResource SidebarButton}">
          <StackPanel Orientation="Horizontal" Spacing="12">
           <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8F1;" FontSize="19"/>
           <TextBlock Text="Study" FontSize="13" />
          </StackPanel>
         </Button>
         <Button x:Name="NavApps" Tag="Apps" Click="Navigate_Click" Style="{StaticResource SidebarButton}">
          <StackPanel Orientation="Horizontal" Spacing="12">
           <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71D;" FontSize="19"/>
           <TextBlock Text="Apps" FontSize="13" />
          </StackPanel>
         </Button>
         <Button x:Name="NavGames" Tag="Gaming" Click="Navigate_Click" Style="{StaticResource SidebarButton}">
          <StackPanel Orientation="Horizontal" Spacing="12">
           <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7FC;" FontSize="19"/>
           <TextBlock Text="Games" FontSize="13" />
          </StackPanel>
         </Button>
         <Button x:Name="NavActivity" Tag="Activity" Click="Navigate_Click" Style="{StaticResource SidebarButton}">
          <StackPanel Orientation="Horizontal" Spacing="12">
           <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE9D9;" FontSize="19"/>
           <TextBlock Text="Activity" FontSize="13" />
          </StackPanel>
         </Button>
         <TextBlock Text="YOUR SESSION" FontSize="10" CharacterSpacing="120" Margin="12,24,0,10" Foreground="{ThemeResource NexusMuted}" />
         <Button x:Name="NavRunning" Tag="Running apps" Click="Navigate_Click" Style="{StaticResource SidebarButton}">
          <StackPanel Orientation="Horizontal" Spacing="12">
           <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" FontSize="19"/>
           <TextBlock Text="Window overview" FontSize="12" />
          </StackPanel>
         </Button>
         <Button x:Name="NavPcControls" Tag="PC controls" Click="Navigate_Click" Style="{StaticResource SidebarButton}">
          <StackPanel Orientation="Horizontal" Spacing="12">
           <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="19"/>
           <TextBlock Text="PC controls" FontSize="13" />
          </StackPanel>
         </Button>
         <Button x:Name="NavPersonalize" Tag="Personalize" Click="Navigate_Click" Style="{StaticResource SidebarButton}">
          <StackPanel Orientation="Horizontal" Spacing="12">
           <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE790;" FontSize="19"/>
           <TextBlock Text="Personalize" FontSize="13" />
          </StackPanel>
         </Button>
         <Border Height="1" Background="{ThemeResource NexusBorder}" Margin="12,14,12,8"/>
         <TextBlock Text="WORKSPACES" FontSize="10" CharacterSpacing="120" Margin="12,0,0,8" Foreground="{ThemeResource NexusMuted}"/>
         <Grid x:Name="ProfileStrip" RowSpacing="4"/>
        </StackPanel>
       </ScrollViewer>
       <Border Grid.Row="1" BorderBrush="{ThemeResource NexusBorder}" BorderThickness="0,1,0,0" Padding="9,16,0,0">
        <StackPanel Spacing="5">
         <TextBlock x:Name="SidebarName" FontSize="13" Foreground="{ThemeResource NexusText}" TextTrimming="CharacterEllipsis" />
         <TextBlock Text="Personal workspace" FontSize="11" Foreground="{ThemeResource NexusMuted}" />
         <TextBlock x:Name="FocusBadge" FontSize="11" Foreground="{ThemeResource NexusMuted}" TextWrapping="Wrap" />
        </StackPanel>
       </Border>
      </Grid>
     </Border>
