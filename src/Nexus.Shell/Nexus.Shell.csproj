<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Nexus.Shell</RootNamespace>
    <AssemblyName>Nexus.Shell</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Nexus.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.1.0</Version>
    <Product>White Dreams Nexus Shell</Product>
    <Description>Nexus desktop shell, native file browsing and Windows-backed system controls.</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Nexus.Runtime/Nexus.Runtime.csproj" />
    <Compile Remove="Models/ShellState.cs;Services/StateStore.cs;Services/AuraPalette.cs;Services/WorkspaceState.cs;Services/ExploreWorkspace.cs;Services/DesktopWorkspace.cs;Services/ShellExperience.cs;Services/CommandSearch.cs;Services/Log.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Icons\*.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Wallpapers\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Nexus.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- An unpackaged publish can omit the app PRI even when native runtime PRIs
       are present. Copy the actual build resources, preserving XBF paths. -->
  <Target Name="NexusPublishXamlResources" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_NexusBuildResources Include="$(TargetDir)**\*.pri;$(TargetDir)**\*.xbf" />
      <_NexusProjectPri Include="$(ProjectPriFullPath)" Condition="'$(ProjectPriFullPath)' != '' and Exists('$(ProjectPriFullPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_NexusBuildResources)"
          DestinationFiles="@(_NexusBuildResources->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_NexusProjectPri)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)resources.pri') and !Exists('$(PublishDir)$(TargetName).pri')"
           Text="The app resource index is missing from publish output. Nexus cannot load MainWindow.xaml without its generated PRI/XBF resources." />
  </Target>
  <!-- ZIP overlays and browser uploads can leave retired files in an old tree.
       Stop with an explicit cleanup instruction before either C# compile pass. -->
  <Target Name="NexusRetiredShortcutGuard" BeforeTargets="XamlPreCompile;CoreCompile">
    <Error Condition="Exists('$(MSBuildProjectDirectory)/Interop/ShellKeyboardHook.cs')"
           Text="Remove Interop/ShellKeyboardHook.cs from the source tree. It is a retired global-shortcut hook; Windows owns native desktop shortcuts." />
  </Target>
</Project>
