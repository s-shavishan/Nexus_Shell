   <Style x:Key="QuietButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="13,10"/>
    <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{ThemeResource NexusText}"/>
   </Style>
   <Style x:Key="AuraSurfaceButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Background" Value="{ThemeResource NexusCard}"/><Setter Property="BorderBrush" Value="{ThemeResource NexusBorder}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,11"/>
   </Style>
